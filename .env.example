# Flask/session security. Generate a long random value for production.
SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated admin passwords for /admin.
ADMIN_PASSWORDS=replace-with-admin-password

# Supabase Postgres connection string.
# Prefer the Supabase pooler connection string on Vercel/serverless.
# If you use the direct string, URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.your-project.supabase.co:5432/postgres?sslmode=require

# Public Supabase values are not used by the current Flask app, but kept here
# for future Supabase Auth/REST work.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# ---------------------------------------------------------------------------
# AI Coach. Two free backends, no credit card needed. Groq wins if both are set.
#   Groq   (preferred, generous free tier): https://console.groq.com/keys  -> "gsk_..."
#   Gemini (fallback):                      https://aistudio.google.com/apikey -> "AIza..."
# With NEITHER key set the coach falls back to the built-in rule-based
# explanations and makes NO API calls, so the app is safe without a key.
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk-replace-with-your-free-groq-key
# GEMINI_API_KEY=AIza-replace-with-your-free-gemini-key

# Optional: pin one model id. LEAVE THIS UNSET unless you have a reason.
# It is put at the FRONT of the active provider's list, so a Gemini id set while
# Groq is active makes every call fail with 404 model_not_found. Unset, the app
# asks Groq which models the key can actually use, which survives Groq retiring
# ids (it retired llama-3.3-70b-versatile and llama-3.1-8b-instant on 2026-08-22).
# AI_MODEL=openai/gpt-oss-120b

# Optional: max AI-coach questions per user per day (cost/abuse guard).
AI_DAILY_LIMIT=40
