# Flask/session security. Generate a long random value for production.
SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated admin passwords for /admin.
ADMIN_PASSWORDS=replace-with-admin-password

# Supabase Postgres connection string.
# Prefer the Supabase pooler connection string on Vercel/serverless.
# If you use the direct string, URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.your-project.supabase.co:5432/postgres?sslmode=require

# Public Supabase values are not used by the current Flask app, but kept here
# for future Supabase Auth/REST work.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# ---------------------------------------------------------------------------
# AI Coach (Anthropic Claude). If ANTHROPIC_API_KEY is unset, the coach falls
# back to the built-in rule-based explanations and NO API calls are made, so
# the app is safe to run/deploy without a key.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
# Optional: override the model. Default is a low-cost current Claude model.
AI_MODEL=claude-haiku-4-5-20251001
# Optional: max AI-coach questions per user per day (cost/abuse guard).
AI_DAILY_LIMIT=40
